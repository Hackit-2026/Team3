# このファイルを .env にコピーして、実際の値を設定してください。
# .env はGit管理対象外です。

# デスクトップ側で `cloudflared tunnel --url http://localhost:11434` を実行すると
# 発行されるHTTPS URL（例: https://xxxx-xxxx.trycloudflare.com）
LOCAL_LLM_BASE_URL=

# デスクトップ側で動かしているモデル名（Ollamaの `ollama list` で確認できる名前）
LOCAL_LLM_MODEL=llama3.1

# デスクトップ側に認証プロキシを立てた場合の合言葉（任意）
LOCAL_LLM_API_KEY=

# LLM応答のタイムアウト秒数（任意、既定15秒）
LOCAL_LLM_TIMEOUT_SEC=15
